[Unit]
Description=eBPF Policy Webserver + Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ebpf-policy
ExecStart=/home/ubuntu/ebpf-policy/webserver -c webserver.conf -f json
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ebpf-webserver

[Install]
WantedBy=multi-user.target
